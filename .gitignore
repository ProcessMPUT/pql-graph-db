### Large Data Files ###
# Uncompressed XES stays out of the repo; fixtures live as .xes.gz under
# src/main/resources/logs/. sample_process.xes is the one tracked exception
# (production load-sample default, tiny).
src/main/resources/logs/*.xes
!src/main/resources/logs/sample_process.xes

# Machine-local benchmark inputs that are intentionally excluded from the
# executable JAR. Active, reproducible benchmark fixtures remain tracked under
# src/main/resources/logs/.
benchmark-data/bpi/archive/
benchmark-data/local/

### Temporary Output ###
tmp/
*.txt
*.log
# Stray ad-hoc Python written during a session is temporary output, but
# everything under scripts/ is the project's operational tooling and must be
# version controlled. Whitelist the whole directory rather than file by file:
# the previous per-file list silently dropped every newly added script.
*.py
__pycache__/
*.pyc
!scripts/
!scripts/*.py
!scripts/benchmarks/
!scripts/benchmarks/*.py
scripts/verify-compatibility.cases.local.json
scripts/verify-compatibility.multi-log.cases.local.json
